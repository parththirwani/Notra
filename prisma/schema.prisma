datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  conversations   Conversation[]
  role            Role             @default(guest)
  workspaceTopics WorkspaceTopic[]
  workspaceItems  WorkspaceItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id        String    @id @default(uuid())
  title     String?
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, createdAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  content        String
  role           MessageRole
  image          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model WorkspaceTopic {
  id        String          @id @default(uuid())
  userId    String
  name      String
  embedding Float[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WorkspaceItem[]

  @@index([userId])
  @@map("workspace_topics")
}

model WorkspaceItem {
  id                   String            @id @default(uuid())
  userId               String
  topicId              String
  type                 WorkspaceItemType
  content              Json
  sourceConversationId String?
  createdAt            DateTime          @default(now())
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic                WorkspaceTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, topicId])
  @@index([userId, type])
  @@map("workspace_items")
}

enum Role {
  admin
  guest
  user
  paid_user
}

enum MessageRole {
  system
  assistant
  user
}

enum WorkspaceItemType {
  mcq
  quiz
  flashcard
}
